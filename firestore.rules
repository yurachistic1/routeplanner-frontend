rules_version = '2';

// Each person can only see and change their own favourites. Anything not
// matched here is denied. Deploy changes with ops/deploy-rules.sh.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/favourites/{id} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      // Route info (warnings and where they are), optional: favourites saved
      // before 2026-11-08 don't have it. Spans are flat lists of point
      // indices, two per stretch. noPavement, back and noPavementSpans are
      // still accepted, from the version of the app that warned about roads
      // without a sidewalk (8-9 Nov), but no longer needed.
      function isValidInfo(i) {
        return i is map
          && i.keys().hasOnly(['countryPaths', 'countryPathSpans', 'noPavement', 'back', 'noPavementSpans'])
          && i.keys().hasAll(['countryPaths', 'countryPathSpans'])
          && i.countryPaths is number && i.countryPaths >= 0 && i.countryPaths <= 250000
          && i.countryPathSpans is list && i.countryPathSpans.size() <= 4000
          && (!('noPavement' in i) || (i.noPavement is number && i.noPavement >= 0 && i.noPavement <= 60000))
          && (!('back' in i) || i.back is bool)
          && (!('noPavementSpans' in i) || (i.noPavementSpans is list && i.noPavementSpans.size() <= 4000));
      }
      // Heights (2026-11-18), optional: the climb in metres, and the height
      // profile, evenly spaced elevationStep metres apart (about 200
      // numbers). Favourites saved before, and GPS art, don't have them.
      function isValidHeights(d) {
        return (!('climb' in d) || (d.climb is number && d.climb >= 0 && d.climb <= 20000))
          && (!('elevation' in d) || (d.elevation is list && d.elevation.size() >= 2 && d.elevation.size() <= 400))
          && (!('elevationStep' in d) || (d.elevationStep is number && d.elevationStep > 0 && d.elevationStep <= 2000))
          && (('elevation' in d) == ('elevationStep' in d));
      }
      function isValid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['line', 'distance', 'savedAt', 'info', 'shape', 'kind', 'climb', 'elevation', 'elevationStep'])
          && d.keys().hasAll(['line', 'distance', 'savedAt'])
          && d.line is string && d.line.size() > 0 && d.line.size() <= 200000
          && d.distance is number && d.distance > 0 && d.distance <= 250000
          && d.savedAt is timestamp && d.savedAt <= request.time
          && (!('info' in d) || isValidInfo(d.info))
          // GPS art: the shape's name (an icon's, or "My shape"), from 2026-11-17.
          && (!('shape' in d) || (d.shape is string && d.shape.size() > 0 && d.shape.size() <= 60))
          // The mode that made it (2026-11-21), optional: favourites saved
          // before don't have it.
          && (!('kind' in d) || d.kind in ['loop', 'art', 'p2p'])
          && isValidHeights(d);
      }
      allow read, delete: if isOwner();
      allow create: if isOwner() && isValid();
      // An A to B favourite follows its route as it's changed (2026-11-21),
      // keeping when it was first saved.
      allow update: if isOwner() && isValid() && request.resource.data.savedAt == resource.data.savedAt;
    }
  }
}
